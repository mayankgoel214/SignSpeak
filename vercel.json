{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "web",
  "installCommand": "echo no dependencies to install",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)\\.(wasm|task)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
